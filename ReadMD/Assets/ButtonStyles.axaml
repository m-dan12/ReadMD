<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="Gray">
            <StackPanel Orientation="Horizontal">
                <Button Classes="minimize" Content="‒"/>
                <Button Classes="maximize" Content="▢"/>
                <Button Classes="close s icon" Content="✗"/>
                <Button Classes="icon s" Content="Текст"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="LightGray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="WindowDecorationProperties.ElementRole" Value="User"/>
		<Style Selector="^.s">
			<Setter Property="Height" Value="28"/>
            <Style Selector="^.icon">
			    <Setter Property="Width" Value="28"/>
            </Style>
        </Style>
		<Style Selector="^.m">
			<Setter Property="Height" Value="36"/>
            <Style Selector="^.icon">
			    <Setter Property="Width" Value="36"/>
            </Style>
        </Style>
		<Style Selector="^.l">
			<Setter Property="Height" Value="44"/>
            <Style Selector="^.icon">
			    <Setter Property="Width" Value="44"/>
            </Style>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="^.minimize">
            <Setter Property="BorderThickness" Value="1 1 0 1"/>
            <Setter Property="CornerRadius" Value="4 0 0 4"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#30FFFFFF"/>
                <Setter Property="BorderThickness" Value="1 1 0 1"/>
                <Setter Property="CornerRadius" Value="4 0 0 4"/>
            </Style>
        </Style>
        <Style Selector="^.maximize">
            <Setter Property="BorderThickness" Value="0 1 0 1"/>
            <Setter Property="CornerRadius" Value="0 0 0 0"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#30FFFFFF"/>
                <Setter Property="BorderThickness" Value="0 1 0 1"/>
                <Setter Property="CornerRadius" Value="0 0 0 0"/>
            </Style>
        </Style>
        <Style Selector="^.close">
            <Setter Property="BorderThickness" Value="0 1 1 1"/>
            <Setter Property="CornerRadius" Value="0 4 4 0"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#30FF0000"/>
                <Setter Property="BorderThickness" Value="0 1 1 1"/>
                <Setter Property="CornerRadius" Value="0 4 4 0"/>
            </Style>
        </Style>
    </Style>
</Styles>
