<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ReadMD.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:svg="using:Avalonia.Svg.Skia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="130"
             x:Class="ReadMD.Views.UpdateNotificationView"
             x:DataType="vm:UpdateNotificationViewModel"
             VerticalAlignment="Bottom">

    <UserControl.Styles>
        <!-- Анимация появления снизу -->
        <Style Selector="Border.popup">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.popup[IsVisible=False]">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(20px)"/>
        </Style>

        <Style Selector="Border.popup[IsVisible=True]">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="popup"
            IsVisible="{Binding IsVisible}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,16,16,12"
            MaxWidth="380"
            Margin="8"
            BoxShadow="0 4 16 2 #40000000"
            VerticalAlignment="Top">

        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
				<!-- Логотип (меняется в зависимости от темы) -->
                <Panel Grid.RowSpan="2" Height="48">
                    <svg:Svg Path="/Assets/logo-dark.svg"
                             IsVisible="{Binding $parent[Window].ActualThemeVariant, Converter={StaticResource ThemeVariantConverter}, ConverterParameter=Light}"/>
                    <svg:Svg Path="/Assets/logo-light.svg"
                             IsVisible="{Binding $parent[Window].ActualThemeVariant, Converter={StaticResource ThemeVariantConverter}, ConverterParameter=Dark}"/>
                </Panel>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <!-- Заголовок -->
                    <TextBlock Grid.Column="1"
                               Text="Доступно обновление"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                    <!-- Сообщение -->
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                        <Run Text="Версия"/>
                        <Run Text="{Binding NewVersion}" FontWeight="SemiBold"/>
                        <Run Text="готова к установке"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            

            <!-- Кнопки -->
            <Grid ColumnDefinitions="* *" HorizontalAlignment="Stretch">
                <Button Command="{Binding InstallUpdateCommand}"
                       IsEnabled="{Binding !IsInstalling}"
                       Background="{DynamicResource SystemAccentColor}"
                       Foreground="White"
                       Padding="8,6"
                       CornerRadius="4"
                       Margin="0,0,4,0"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <ic:FluentIcon Icon="ArrowDownload" FontSize="16" IsVisible="{Binding !IsInstalling}"/>
                        <ic:FluentIcon Icon="ArrowSync" FontSize="16" IsVisible="{Binding IsInstalling}"/>
                        <TextBlock Text="{Binding IsInstalling, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Обновление...|Обновить'}" Margin="4 0"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Command="{Binding DismissCommand}"
                       IsEnabled="{Binding !IsInstalling}"
                       Background="Transparent"
                       BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                       BorderThickness="1"
                       Padding="12,6"
                       CornerRadius="4"
                       Margin="4,0,0,0"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center">
                    <TextBlock Text="Позже" FontSize="13"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
