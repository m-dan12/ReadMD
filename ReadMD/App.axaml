<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="ReadMD.App"
			 xmlns:local="using:ReadMD"
			 xmlns:converters="clr-namespace:ReadMD.Converters"
			 RequestedThemeVariant="Default">
	<!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Resources>
		<ResourceDictionary>
			<converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
			<FontFamily x:Key="LatoFont">avares://ReadMD/Assets/Fonts#Lato</FontFamily>
			<FontFamily x:Key="LoraFont">avares://ReadMD/Assets/Fonts#Lora</FontFamily>
			<FontFamily x:Key="FiraFont">avares://ReadMD/Assets/Fonts#Fira Mono</FontFamily>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Default">
					<BoxShadows x:Key="ReadMDPopupBoxShadow">0 0 4 0 #28000000</BoxShadows>
					<SolidColorBrush x:Key="ReadMDSegmentSelectedBackgroundBrush" Color="#FFFFFFFF"/>
					<SolidColorBrush x:Key="ReadMDSegmentSelectedForegroundBrush" Color="#FF000000"/>
					<!-- Checked состояние кнопок: темный фон, белая иконка -->
					<SolidColorBrush x:Key="ButtonCheckedBackground" Color="#18191b"/>
					<SolidColorBrush x:Key="ButtonCheckedForeground" Color="#f6f6f7"/>
					<!-- Лого для начального экрана -->
					<SolidColorBrush x:Key="ReadMDLogo">avares://ReadMD/Assets/ReadMD-logo-dark.svg</SolidColorBrush>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Light">
					<BoxShadows x:Key="ReadMDPopupBoxShadow">0 0 4 0 #28000000</BoxShadows>
					<SolidColorBrush x:Key="ReadMDSegmentSelectedBackgroundBrush" Color="#FFFFFFFF"/>
					<SolidColorBrush x:Key="ReadMDSegmentSelectedForegroundBrush" Color="#FF000000"/>
					<!-- Checked состояние кнопок: темный фон, белая иконка -->
					<SolidColorBrush x:Key="ButtonCheckedBackground" Color="#18191b"/>
					<SolidColorBrush x:Key="ButtonCheckedForeground" Color="#f6f6f7"/>
					<!-- Лого для начального экрана -->
					<StreamGeometry x:Key="ReadMDLogo">avares://ReadMD/Assets/ReadMD-logo-dark.svg</StreamGeometry>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<BoxShadows x:Key="ReadMDPopupBoxShadow">0 0 12 0 #80000000</BoxShadows>
					<SolidColorBrush x:Key="ReadMDSegmentSelectedBackgroundBrush" Color="#FF1e1e1e"/>
					<SolidColorBrush x:Key="ReadMDSegmentSelectedForegroundBrush" Color="#FFFFFFFF"/>
					<!-- Checked состояние кнопок: светлый фон, черная иконка -->
					<SolidColorBrush x:Key="ButtonCheckedBackground" Color="#edeeef"/>
					<SolidColorBrush x:Key="ButtonCheckedForeground" Color="#000000"/>
					<!-- Фон попапа: такой же как основной фон приложения -->
					<SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#18191b"/>
					<!-- Лого для начального экрана -->
					<StreamGeometry x:Key="ReadMDLogo">avares://ReadMD/Assets/ReadMD-logo-light.svg</StreamGeometry>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme>
			<FluentTheme.Palettes>
				<ColorPaletteResources x:Key="Light"
					Accent="#18191b"
					RegionColor="#f6f6f7"
					ErrorText="#d32f2f" />
				<ColorPaletteResources x:Key="Dark"
					Accent="#c9cbcf"
					RegionColor="#18191b"
					ErrorText="#ef5350" />
			</FluentTheme.Palettes>
		</FluentTheme>
		<StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
		<StyleInclude Source="/Assets/Styles.axaml" />
	</Application.Styles>
</Application>